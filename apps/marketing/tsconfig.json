{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "globalConsole": "off", "globalFetch": "off" }
      }
    ]
  },
  "include": ["src", "vite.config.ts"]
}
