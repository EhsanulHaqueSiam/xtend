{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // page.evaluate callbacks run in the page.
    "lib": ["ESNext", "DOM"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "nodeBuiltinImport": "off",
          "globalDate": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off",
          "preferSchemaOverJson": "off"
        }
      }
    ]
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
