{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xtend-pool",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The Neon pool, through Hyperdrive: the connection string lives in Cloudflare, never here.
  "hyperdrive": [{ "binding": "POOL", "id": "395fa092434e4c5db9ae48c478653157" }],
  "ratelimits": [
    { "name": "REGISTER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "PUSH", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
}
