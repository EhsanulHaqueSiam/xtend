{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xtend-pool",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The Neon pool, through Hyperdrive: the connection string lives in Cloudflare, never here.
  "hyperdrive": [{ "binding": "POOL", "id": "395fa092434e4c5db9ae48c478653157" }],
  "ratelimits": [
    { "name": "REGISTER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "PUSH", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "PUSH_ADDRESS", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
  ],
  // Pushes wait in one SQLite-backed object (free plan) until the hourly flush.
  "durable_objects": { "bindings": [{ "name": "BUFFER", "class_name": "PoolBuffer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PoolBuffer"] }],
  // Neon bills by the minute awake and sleeps 5 minutes after the last query: one wake an hour.
  "triggers": { "crons": ["0 * * * *"] },
}
