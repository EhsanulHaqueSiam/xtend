{
  "name": "@xtend/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "XTEND_DESKTOP_DEV=1 vp pack --watch",
    "build": "vp pack",
    "start": "electron .",
    "typecheck": "tsc-rs --noEmit",
    "test": "vp test run --passWithNoTests",
    "dist": "[ -n \"$CSC_LINK\" ] || { unset CSC_LINK CSC_KEY_PASSWORD; export CSC_IDENTITY_AUTO_DISCOVERY=false; }; electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:dir": "electron-builder --dir",
    "ensure:electron": "node -e \"require('electron')\"",
    "verify:bundles": "node scripts/verify-bundles.mjs",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@xtend/contracts": "workspace:*",
    "effect": "catalog:",
    "electron": "catalog:",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "vite-plus": "catalog:"
  },
  "productName": "Xtend"
}
