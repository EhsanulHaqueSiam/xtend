{
  "name": "xtend",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "xtend": "./dist/bin.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages src/bin.ts --base-dir ${XTEND_HOME:-../../.xtend} --port ${XTEND_PORT:-4820} --dev-url http://localhost:${XTEND_WEB_PORT:-5820}",
    "build": "vp pack",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc-rs --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@xtend/contracts": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
