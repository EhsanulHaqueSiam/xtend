{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"],
    },
    "apps/desktop": {
      "entry": [
        "src/main.ts",
        "src/preload.ts",
        "scripts/dev-electron.mjs",
        "scripts/cdp-screenshot.mjs",
      ],
    },
  },
}
