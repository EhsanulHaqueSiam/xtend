{
  "name": "@corvid/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @corvid/contracts --filter @corvid/web --filter corvid --parallel dev",
    "dev:server": "vp run --filter corvid dev",
    "dev:web": "vp run --filter @corvid/web dev",
    "dev:desktop": "vp run --filter @corvid/desktop dev",
    "build": "vp run --filter './apps/*' build",
    "typecheck": "vp run -r --cache --concurrency-limit 4 typecheck",
    "tc": "vp run -r --cache --concurrency-limit 4 typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "knip": "knip",
    "test": "vp run -r test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "tsc-rs": "0.7.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.11.0"
  },
  "packageManager": "pnpm@12.14.0"
}
