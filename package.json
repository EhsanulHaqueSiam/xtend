{
  "name": "@xtend/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --filter @xtend/contracts --filter @xtend/web --filter xtend --parallel dev",
    "dev:server": "vp run --filter xtend dev",
    "dev:web": "vp run --filter @xtend/web dev",
    "dev:desktop": "vp run --filter @xtend/desktop dev",
    "build": "vp run --filter './apps/*' build",
    "build:desktop": "vp run --filter @xtend/web --filter xtend --filter @xtend/desktop build && pnpm --filter @xtend/desktop dist",
    "typecheck": "vp run -r --cache --concurrency-limit 4 typecheck",
    "tc": "vp run -r --cache --concurrency-limit 4 typecheck",
    "check:changed": "node scripts/check-changed.ts",
    "lint": "vp lint --report-unused-disable-directives",
    "knip": "knip",
    "test": "vp run -r test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "tsc-rs": "0.7.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.11.0"
  },
  "packageManager": "pnpm@12.14.0"
}
