{
  "name": "@xtend/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "build": "vp run --filter './apps/*' build",
    "build:desktop": "pnpm dist:desktop:dmg",
    "dist:desktop:dmg": "pnpm build && pnpm --filter @xtend/desktop verify:bundles && pnpm --filter @xtend/desktop dist",
    "dist:desktop:dmg:arm64": "pnpm dist:desktop:dmg dmg zip --arm64",
    "dist:desktop:dmg:x64": "pnpm dist:desktop:dmg dmg zip --x64",
    "dist:desktop:appimage": "pnpm build && pnpm --filter @xtend/desktop verify:bundles && pnpm --filter @xtend/desktop dist:linux",
    "release:smoke": "node scripts/release-smoke.ts",
    "cli:pack": "node scripts/pack-cli.ts",
    "typecheck": "vp run -r --cache --concurrency-limit 4 typecheck",
    "tc": "vp run -r --cache --concurrency-limit 4 typecheck",
    "check:changed": "node scripts/check-changed.ts",
    "lint": "vp lint --report-unused-disable-directives",
    "knip": "knip",
    "test": "vp run -r test && vp test run --dir scripts && node --test .github/scripts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "tsc-rs": "0.7.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.11.0"
  },
  "packageManager": "pnpm@12.14.0"
}
