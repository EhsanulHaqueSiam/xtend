{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["ESNext"],
    // A plain Cloudflare worker, not an Effect program.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "globalConsole": "off", "globalDate": "off" }
      }
    ]
  },
  "include": ["src"]
}
