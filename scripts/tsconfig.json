{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // page.evaluate callbacks in the scenarios run in the page.
    "lib": ["ESNext", "esnext.disposable", "DOM"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "nodeBuiltinImport": "off",
          "globalDate": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalConsole": "off",
          "globalFetch": "off",
          "preferSchemaOverJson": "off"
        }
      }
    ]
  },
  "include": ["*.ts", "scenarios"]
}
